# Auto-generated by BestEnchSeq-Core build — do not edit.
# Plugin build: cmake -S plugins -B build/plugins -DBESQ_CORE_DIR=<build>

get_filename_component(_besq_build "${CMAKE_CURRENT_LIST_DIR}" ABSOLUTE)
get_filename_component(_besq_src "${_besq_build}/.." ABSOLUTE)

# Host build type — plugins must match it (Windows _ITERATOR_DEBUG_LEVEL).
set(BESQ_HOST_BUILD_TYPE "@CMAKE_BUILD_TYPE@")
set(HOST_CMAKE_CXX_COMPILER "@CMAKE_CXX_COMPILER@")

# ── besq-algo-core — the SHARED algorithm kernel (纯净扩展) ────────────
# The parent (via besq-core), the sandbox worker, AND plugins all link this
# same shared lib, so the algorithm domain (DiagnosticsService, IAlgorithm
# vtables, singletons) resolves to ONE instance per process.
if(WIN32)
    add_library(besq-algo-core::besq-algo-core SHARED IMPORTED)
    set_target_properties(besq-algo-core::besq-algo-core PROPERTIES
        IMPORTED_LOCATION "${_besq_build}/bin/besq-algo-core.dll"
        IMPORTED_IMPLIB   "${_besq_build}/besq-algo-core.lib"
        INTERFACE_INCLUDE_DIRECTORIES "${_besq_src}/src;${_besq_build}/generated;${_besq_src}/src/common"
        INTERFACE_COMPILE_DEFINITIONS "@BESQ_PLUGIN_DIAG_DEFS@"
    )
else()
    add_library(besq-algo-core::besq-algo-core SHARED IMPORTED)
    set_target_properties(besq-algo-core::besq-algo-core PROPERTIES
        IMPORTED_LOCATION "${_besq_build}/libbesq-algo-core.so"
        IMPORTED_SONAME   "libbesq-algo-core.so"
        INTERFACE_INCLUDE_DIRECTORIES "${_besq_src}/src;${_besq_build}/generated;${_besq_src}/src/common"
        INTERFACE_COMPILE_DEFINITIONS "@BESQ_PLUGIN_DIAG_DEFS@"
    )
endif()
