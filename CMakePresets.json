{
    "version": 6,
    "configurePresets": [
        {
            "name": "full",
            "displayName": "Full (all targets)",
            "description": "Build everything: libraries, CLI, tests, benchmarks (Release)",
            "binaryDir": "${sourceDir}/build",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_C_COMPILER": "clang",
                "BESQ_BUILD_CLI": "ON",
                "BESQ_BUILD_SANDBOX": "ON",
                "BUILD_TESTING": "ON",
                "BUILD_BENCHMARKS": "ON",
                "BESQ_MAX_SOLUTIONS": "32"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug (all targets)",
            "description": "Build everything with debug symbols and tests enabled",
            "binaryDir": "${sourceDir}/build",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_C_COMPILER": "clang",
                "BESQ_BUILD_CLI": "ON",
                "BESQ_BUILD_SANDBOX": "ON",
                "BUILD_TESTING": "ON",
                "BUILD_BENCHMARKS": "ON",
                "BESQ_MAX_SOLUTIONS": "128"
            }
        },
        {
            "name": "cli",
            "displayName": "CLI (default)",
            "description": "Build the besq CLI executable and its dependencies (Release). No tests or benchmarks.",
            "binaryDir": "${sourceDir}/build",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_C_COMPILER": "clang",
                "BESQ_BUILD_CLI": "ON",
                "BESQ_BUILD_SANDBOX": "OFF",
                "BUILD_TESTING": "OFF",
                "BUILD_BENCHMARKS": "OFF",
                "BESQ_MAX_SOLUTIONS": "32"
            }
        },
        {
            "name": "minimal",
            "displayName": "Minimal (algorithm kernel only)",
            "description": "Build only the besq-algo-core algorithm kernel (STATIC). No CLI, worker, tests, or benchmarks.",
            "binaryDir": "${sourceDir}/build",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_C_COMPILER": "clang",
                "BESQ_BUILD_CLI": "OFF",
                "BESQ_BUILD_SANDBOX": "OFF",
                "BUILD_TESTING": "OFF",
                "BUILD_BENCHMARKS": "OFF",
                "BESQ_MAX_SOLUTIONS": "32"
            }
        },
        {
            "name": "sandbox",
            "displayName": "Sandbox (worker only)",
            "description": "Build only the besq-worker sandbox executable and its dependencies (algorithm kernel + worker sources).",
            "binaryDir": "${sourceDir}/build",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_C_COMPILER": "clang",
                "BESQ_BUILD_CLI": "OFF",
                "BESQ_BUILD_SANDBOX": "ON",
                "BUILD_TESTING": "OFF",
                "BUILD_BENCHMARKS": "OFF",
                "BESQ_MAX_SOLUTIONS": "128"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "full",
            "configurePreset": "full",
            "displayName": "Build all targets",
            "description": "Build everything (libraries + CLI + worker + tests + benchmarks)"
        },
        {
            "name": "debug",
            "configurePreset": "debug",
            "displayName": "Debug (all targets)",
            "description": "Build all targets with debug symbols"
        },
        {
            "name": "cli",
            "configurePreset": "cli",
            "displayName": "CLI executable",
            "description": "Build the besq CLI and its dependencies",
            "targets": ["besq"]
        },
        {
            "name": "minimal",
            "configurePreset": "minimal",
            "displayName": "Algorithm kernel",
            "description": "Build the besq-algo-core algorithm kernel only",
            "targets": ["besq-algo-core"]
        },
        {
            "name": "sandbox",
            "configurePreset": "sandbox",
            "displayName": "Sandbox worker",
            "description": "Build the besq-worker sandbox executable only",
            "targets": ["besq-worker"]
        }
    ],
    "testPresets": [
        {
            "name": "full",
            "configurePreset": "full",
            "displayName": "Run all tests",
            "description": "Run the complete test suite"
        },
        {
            "name": "debug",
            "configurePreset": "debug",
            "displayName": "Run all tests (debug)",
            "description": "Run the complete test suite (debug build)"
        }
    ]
}
